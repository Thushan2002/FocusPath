{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "BETTER_AUTH_*", "GOOGLE_*", "AI_SERVICE_*", "REDIS_URL", "SMTP_*", "APP_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL"]
    }
  }
}
