# Copy to .env at the repo root. apps/web, apps/worker and packages/db read it.

APP_URL=http://localhost:3000

# Postgres (docker-compose maps it to host port 5433)
DATABASE_URL=postgres://focuspath:focuspath@localhost:5433/focuspath
TEST_DATABASE_URL=postgres://focuspath:focuspath@localhost:5433/focuspath_test

# Redis (BullMQ + rate limiting)
REDIS_URL=redis://localhost:6379

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional in dev; the button is hidden when unset)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail (Mailpit in dev — UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="FocusPath AI <no-reply@focuspath.local>"

# AI service (server-to-server only; never exposed to the browser).
# Use 127.0.0.1, not localhost: Node resolves localhost to ::1 and uvicorn listens on IPv4.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SECRET=change-me-shared-secret

# ---- services/ai reads these ----
ANTHROPIC_API_KEY=
# "fake" returns deterministic fixtures (no API key needed; used by E2E tests)
AI_MODE=live
AI_MODEL=claude-opus-5-5
